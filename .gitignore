node_modules/
.next/
# Secrets stay local. The example is the one exception and is tracked on
# purpose, so the required variable names are reviewable without their values.
.env*
!.env.example
.DS_Store
*.log
.playwright-mcp/
validate_fixture.py
portal-protocol.png
# Stray screenshots and scratch images stay out of the repository. The README
# gallery is the deliberate exception: those files are referenced by absolute
# raw.githubusercontent URLs, so they only render once they are committed here.
*.png
!docs/screenshots/*.png

# Python bytecode — a .pyc was committed into the shipped plugin once already
__pycache__/
*.py[cod]

# The generated schema site (framework/portal/scripts/build-schema-site.mjs).
# Cloudflare Pages builds it on deploy; a committed copy would be a second,
# staler answer to a URL that must have exactly one.
dist/

# The published catalog is a crawl of the local portal — generated on every
# publish, never reviewed, and large.  rebuilds it.
deploy/public/
deploy/schemas/public/
