{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.metaframework.dev/acme/product/billing/datamodel/ledger-entry",
  "x-srn": "srn://acme/product/billing/datamodel/ledger-entry",
  "title": "Ledger entry",
  "description": "One leg of a balanced double-entry posting.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://schemas.metaframework.dev/acme/datamodel/base-record"
    },
    {
      "$ref": "https://schemas.metaframework.dev/acme/datamodel/auditable"
    }
  ],
  "properties": {
    "order-id": {
      "type": "string",
      "format": "uuid",
      "description": "The order whose payment fact produced this leg."
    },
    "batch-id": {
      "type": "string",
      "format": "uuid",
      "description": "Posting batch; all legs of one movement share it and sum to zero."
    },
    "direction": {
      "enum": [
        "debit",
        "credit"
      ],
      "description": "Explicit direction. Amounts are never signed."
    },
    "amount": {
      "$ref": "https://schemas.metaframework.dev/acme/datamodel/money",
      "description": "Magnitude of this leg."
    },
    "account": {
      "type": "string",
      "maxLength": 64,
      "description": "Chart-of-accounts code this leg posts to."
    },
    "posted-at": {
      "type": "string",
      "format": "date-time",
      "description": "When the leg became durable."
    }
  },
  "required": [
    "order-id",
    "batch-id",
    "direction",
    "amount",
    "account"
  ]
}
