{
  "name": "@bershadsky/metaframework",
  "version": "0.5.0",
  "description": "Serve a metaframework solution catalog — a reviewable file tree of markdown entities — as a live portal, with reload on change",
  "keywords": [
    "architecture",
    "architecture-as-code",
    "catalog",
    "documentation",
    "docs-as-code",
    "json-schema",
    "metaframework",
    "solution-design"
  ],
  "homepage": "https://github.com/sergio-bershadsky/metaframework#readme",
  "bugs": "https://github.com/sergio-bershadsky/metaframework/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergio-bershadsky/metaframework.git",
    "directory": "framework/portal"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Sergey Bershadsky",
  "type": "module",
  "bin": {
    "metaframework": "bin/metaframework.mjs"
  },
  "files": [
    "bin/*.mjs",
    "!bin/*.test.mjs",
    ".next/standalone/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint",
    "package": "npm run build && node scripts/assemble-standalone.mjs",
    "prepack": "node scripts/build-embedded-schemas.mjs --check && npm run package",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "jotai": "1.11.2"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@stoplight/json-schema-viewer": "^4.16.4",
    "@stoplight/markdown-viewer": "^5.7.1",
    "@stoplight/mosaic": "^1.53.5",
    "@stoplight/mosaic-code-viewer": "^1.53.5",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xyflow/react": "^12.11.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.32.0",
    "mermaid": "^11.17.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "xstate": "^5.32.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
