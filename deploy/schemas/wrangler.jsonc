{
  "$schema": "../../framework/portal/node_modules/wrangler/config-schema.json",
  "name": "metaframework-schemas",
  "compatibility_date": "2026-08-31",

  // A second Worker rather than a second route on the catalog's, because the two
  // sites have different roots: the catalog serves `/catalog/…`, and a schema is
  // addressed by its `$id` — host plus the SRN path, no prefix. One asset store
  // cannot be rooted two ways, and a script that branched on Host would be code
  // where a directory will do.
  "assets": {
    "directory": "./public",
    // Extensionless documents, so nothing here is an HTML route. Without this a
    // request for `/acme/datamodel/money` would be treated as a page lookup.
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Hostnames are NOT declared here, and that is deliberate. A `custom_domain`
  // route needs account-level `workers/domains`, which neither available token
  // carries: CF_TOKEN has the metaframework.dev zone but no account Workers
  // access, and CF_SOCKET0_TOKEN has account Workers but is zone-scoped to
  // socket0.com. Declaring a route wrangler cannot create would fail every
  // deploy.
  //
  // Instead the hostname is attached once, out of band, as a zone Workers route
  // plus a proxied DNS record — see deploy/README.md. A deploy then only
  // replaces content, which is the part that changes.
  "workers_dev": true,

  "observability": { "enabled": true }
}
